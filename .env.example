# NOW! Engine — environment template.
#
# Copy to `.env` and fill in real values before running `docker compose up`.
# NEVER commit `.env`. Every secret below MUST be replaced for anything
# beyond a throwaway local sandbox — the values here are either safe
# defaults (ports, hostnames, non-secret config) or clearly-fake
# placeholders, never real credentials.
#
# Generate secrets with:
#   openssl rand -hex 32          # for *_SECRET / *_KEY hex values
#   openssl rand -base64 32       # for *_TOKEN values

# -----------------------------------------------------------------------
# Postgres 16 + pgvector + PostGIS (three DBs: now_platform, now_jakarta,
# now_bali — created by engine/infra/postgres/init/01-create-databases.sh)
# -----------------------------------------------------------------------
POSTGRES_USER=now
POSTGRES_PASSWORD=changeme-postgres-password
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# -----------------------------------------------------------------------
# Redis — arq queue + cache
# -----------------------------------------------------------------------
REDIS_PASSWORD=changeme-redis-password
REDIS_PORT=6379

# -----------------------------------------------------------------------
# Garage — S3-compatible object store (single node). See
# engine/infra/garage/README section in engine/infra/README.md for the
# one-time cluster bootstrap (layout + bucket + key).
# -----------------------------------------------------------------------
GARAGE_RPC_SECRET=changeme-generate-with-openssl-rand-hex-32
GARAGE_ADMIN_TOKEN=changeme-generate-with-openssl-rand-base64-32
GARAGE_METRICS_TOKEN=changeme-generate-with-openssl-rand-base64-32
GARAGE_S3_REGION=garage
GARAGE_S3_PORT=3900
GARAGE_WEB_PORT=3902
GARAGE_ADMIN_PORT=3903
GARAGE_MEDIA_BUCKET=now-media
# Access key imported into Garage by engine/infra/garage/init.sh — must
# start with "GK" (Garage's expected access-key-id prefix).
GARAGE_ACCESS_KEY_ID=GKchangemechangeme
GARAGE_SECRET_ACCESS_KEY=changeme-generate-with-openssl-rand-hex-32

# -----------------------------------------------------------------------
# imgproxy — on-demand derivatives, sourced from Garage over S3
# -----------------------------------------------------------------------
IMGPROXY_PORT=8080
# HMAC signing secrets for signed imgproxy URLs. Required in production —
# without them anyone can request arbitrary transforms of any source image.
IMGPROXY_KEY=changeme-generate-with-openssl-rand-hex-32
IMGPROXY_SALT=changeme-generate-with-openssl-rand-hex-32

# -----------------------------------------------------------------------
# Caddy — TLS + routing (ARCHITECTURE.md §3.5)
#
# Local dev: point these at *.localhost (Caddy serves them over HTTPS with
# its internal CA automatically, no DNS needed — add /etc/hosts entries only
# if your resolver doesn't already handle *.localhost).
# Production: the real domains; Caddy issues public ACME certs automatically.
# -----------------------------------------------------------------------
CADDY_ACME_EMAIL=ops@example.com
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
NOW_JAKARTA_HOSTNAME=nowjakarta.localhost
NOW_BALI_HOSTNAME=nowbali.localhost
CMS_JAKARTA_HOSTNAME=cms.nowjakarta.localhost
CMS_BALI_HOSTNAME=cms.nowbali.localhost
ENGINE_API_HOSTNAME=engine.now.localhost
MEDIA_HOSTNAME=media.now.localhost
# Production values (uncomment / replace the block above):
# NOW_JAKARTA_HOSTNAME=nowjakarta.co.id
# NOW_BALI_HOSTNAME=nowbali.co.id
# CMS_JAKARTA_HOSTNAME=cms.nowjakarta.co.id
# CMS_BALI_HOSTNAME=cms.nowbali.co.id
# ENGINE_API_HOSTNAME=engine.now.id
# MEDIA_HOSTNAME=media.now.id

# Public base URL apps should build media URLs against (through Caddy, in
# prod this is https://media.now.id or a Cloudflare-fronted equivalent).
MEDIA_PUBLIC_URL=http://localhost:8080

# -----------------------------------------------------------------------
# Backups — local dump directory + optional S3-compatible remote (R2/B2)
# -----------------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_REMOTE_ENABLED=false
# Cloudflare R2 example: https://<account_id>.r2.cloudflarestorage.com
# Backblaze B2 example:  https://s3.<region>.backblazeb2.com
BACKUP_REMOTE_ENDPOINT=
BACKUP_REMOTE_BUCKET=
BACKUP_REMOTE_ACCESS_KEY_ID=
BACKUP_REMOTE_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------
# Placeholder application services — engine-api, engine-worker, cms-*, web,
# console. Not started by default (behind the `apps` compose profile; see
# docker-compose.yml header). Filled in as those tasks land.
# -----------------------------------------------------------------------
ENGINE_API_IMAGE=now-engine-api:local
ENGINE_WORKER_IMAGE=now-engine-worker:local
CMS_IMAGE=now-cms:local
WEB_IMAGE=now-web:local
CONSOLE_IMAGE=now-console:local

# -----------------------------------------------------------------------
# Live WordPress source — used ONLY by scripts/wp-dump.{sh,ps1} to pull a
# fresh dump of the legacy sites into <site>/db/dumps/.
#
# WordPress is a migration source, never a production dependency
# (ARCHITECTURE.md §6). Nothing in the running stack reads these.
#
# The script is read-only on the remote: mysqldump and tar are piped through
# gzip into the SSH stream, so no file is ever written on the live server.
#
# AUTH — use a key, not a password.
#   1. ssh-keygen -t ed25519 -f ~/.ssh/now_hostinger -C "now-engine-dump" -N ""
#   2. Paste ~/.ssh/now_hostinger.pub into
#      hPanel → Advanced → SSH Access → Manage SSH keys
#   3. Set WP_SSH_KEY below to the PRIVATE key path
# A key is revocable in one click, is not replayable elsewhere, and keeps the
# hosting password out of this file, your shell history and your logs.
# wp-dump.sh can fall back to WP_SSH_PASSWORD if sshpass is installed;
# wp-dump.ps1 deliberately cannot.
# -----------------------------------------------------------------------
WP_SSH_HOST=
WP_SSH_PORT=65002
WP_SSH_USER=
WP_SSH_KEY=
# WP_SSH_PASSWORD=        # discouraged; requires sshpass; .sh only

# Database names, per site slug: WP_DB_<SLUG>
WP_DB_JAKARTA=
WP_DB_BALI=

# Only needed for --uploads. Domain directory names under WP_REMOTE_ROOT.
WP_REMOTE_ROOT=/home/<hosting-account>/domains
WP_DOMAIN_JAKARTA=
WP_DOMAIN_BALI=

# -----------------------------------------------------------------------
# Nominatim — self-hosted OSM geocoder (E2.5 / ARCHITECTURE.md §15).
# Only used by the `geo` compose profile:
#   docker compose --profile geo up -d nominatim
# First start downloads the extract and runs a FULL IMPORT (hours).
# -----------------------------------------------------------------------
NOMINATIM_PORT=8088
# Full Indonesia covers Jakarta, Bali and every future region in one
# import. Geofabrik does not publish Bali as a standalone sub-extract.
NOMINATIM_PBF_URL=https://download.geofabrik.de/asia/indonesia-latest.osm.pbf
NOMINATIM_REPLICATION_URL=https://download.geofabrik.de/asia/indonesia-updates/
# extratags keeps opening_hours, which E5's itinerary slot fill needs.
NOMINATIM_IMPORT_STYLE=extratags
NOMINATIM_PASSWORD=nominatim
NOMINATIM_THREADS=6
# Sized for a ~8GB Docker VM. The image's own defaults (10GB
# maintenance_work_mem, 24GB effective_cache_size) assume a large server
# and will OOM mid-import on a laptop. Raise on the Hetzner CPX41.
NOMINATIM_SHARED_BUFFERS=1500MB
NOMINATIM_MAINTENANCE_WORK_MEM=2GB
NOMINATIM_AUTOVACUUM_WORK_MEM=512MB
NOMINATIM_WORK_MEM=50MB
NOMINATIM_EFFECTIVE_CACHE_SIZE=4GB

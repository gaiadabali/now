# NOW! Engine — production environment for the VPS.
#
#   cp deploy/.env.example deploy/.env   # then fill in every :? value
#
# deploy/.env is gitignored and must stay that way. Generate secrets on the
# box, do not reuse anything from local dev, and do not paste them into a
# chat, a ticket or a commit message.
#
#   openssl rand -hex 32
#
# Compose fails fast on anything marked REQUIRED below: the `:?` syntax
# aborts before a container starts rather than booting a service with a
# silently-empty password.

# ============================================================================
# Images — REQUIRED. Published by .github/workflows/publish-images.yml.
# ============================================================================
# IMAGE_TAG is one short SHA shared by all four images, so a deploy and a
# rollback name exactly one build. `latest` is deliberately unusable here: a
# rollback has to be able to say what it is rolling back to.
POSTGRES_IMAGE=ghcr.io/gaiadabali/now-postgres
API_IMAGE=ghcr.io/gaiadabali/now-api
WEB_IMAGE=ghcr.io/gaiadabali/now-web
CMS_IMAGE=ghcr.io/gaiadabali/now-cms
WORKER_IMAGE=ghcr.io/gaiadabali/now-worker
CONSOLE_IMAGE=ghcr.io/gaiadabali/now-console
IMAGE_TAG=

# ============================================================================
# Database — REQUIRED
# ============================================================================
# One Postgres instance, three databases (ARCHITECTURE.md §2). This user owns
# all of them; the API and CMS both connect as it today.
POSTGRES_USER=now
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# ============================================================================
# Redis — REQUIRED. Rate-limit backend for the API, queue for the worker.
# ============================================================================
REDIS_PASSWORD=

# ============================================================================
# Payload — REQUIRED. Signs CMS sessions.
# ============================================================================
# Both instances share it: they are one deployment of one config against two
# databases, and a rotated secret should log everyone out of both at once.
PAYLOAD_SECRET=

# ============================================================================
# Hostnames — REQUIRED. Must match the nginx vhosts on the host.
# ============================================================================
# Used by nginx/CloudPanel to route to the right per-city web process.
# The app itself does not read a Host header — it is told which city it is
# via SITE_SLUG in the compose file.
NOW_JAKARTA_HOSTNAME=now-jakarta.gaiada.com
NOW_BALI_HOSTNAME=now-bali.gaiada.com

# ============================================================================
# Host ports — loopback only, nginx proxies to them.
# ============================================================================
# helios is a shared CloudPanel box with 18 other vhosts. These defaults were
# verified free there on 2026-09-14 — both unlistened AND unreferenced in
# nginx, because a port named by someone else's vhost with nothing behind it
# looks free to `ss` and silently hijacks their domain if you take it.
API_HOST_PORT=4310
# One web process per city — src/lib/site.ts requires SITE_SLUG and serves
# exactly one city per process.
WEB_JAKARTA_HOST_PORT=4311
WEB_BALI_HOST_PORT=4315
CMS_JAKARTA_HOST_PORT=4312
CMS_BALI_HOST_PORT=4313
IMGPROXY_HOST_PORT=4314
# console is read-only but still internal — put auth in front before exposing.
CONSOLE_HOST_PORT=4316

LOG_LEVEL=INFO

# ============================================================================
# Worker
# ============================================================================
# How far ahead daily partitions are created. An INSERT for a date with no
# partition fails outright, so this is runway, not tuning.
PARTITION_DAYS_AHEAD=14
# Blank = never drop. Only set this with a deliberate reason: it destroys
# behavioural data permanently and E7 is gated on accumulating it.
INTERACTION_RETENTION_DAYS=
# The re-embed-on-publish consumer runs inside the worker process. Set false
# to run it as its own service, or to save ~250 MB on a constrained box.
RUN_REEMBED_CONSUMER=true

# ============================================================================
# Beacon origins — TEMPORARY, delete at the DNS cutover.
# ============================================================================
# The beacon's only gate is a CORS allowlist built from `engine.sites.hostname`,
# which holds each city's POST-CUTOVER hostname. While the engine is served
# from a staging domain the registry does not name, every batch is rejected
# 403 — the site's own front end judged exactly like a hostile one. This names
# where the site is served today.
#
# Keyed by site slug, never a flat list: a flat list would let one city's
# origin write behaviour into another city's database.
#
#   ENGINE_API_EXTRA_ALLOWED_ORIGINS={"jakarta":["https://now-jakarta.gaiada.com"],"bali":["https://now-bali.gaiada.com"]}
#
# Leaving it blank is safe and means "no extra origins" — that is how this
# variable is meant to end, once `hostname` and the served domain agree. Do
# NOT instead edit `sites.hostname`: that column also drives `metadataBase` in
# the reader app, so moving it drags canonical and OG URLs onto the staging
# domain.
ENGINE_API_EXTRA_ALLOWED_ORIGINS=

# ============================================================================
# Media path — OPTIONAL, and unused until E1.3 unblocks.
# ============================================================================
# garage + imgproxy sit behind the `media` compose profile and are OFF by
# default: the media mirror has not run, so they would serve an empty bucket
# while costing ~640 MB on a box with ~4 GB free. web/next.config.mjs still
# points remotePatterns at the legacy WordPress hosts.
#
# Fill these in and `docker compose --profile media up -d` in the same change
# that mirrors wp-content/uploads.
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_METRICS_TOKEN=
GARAGE_ACCESS_KEY_ID=
GARAGE_SECRET_ACCESS_KEY=
GARAGE_MEDIA_BUCKET=now-media
GARAGE_S3_REGION=garage
IMGPROXY_KEY=
IMGPROXY_SALT=

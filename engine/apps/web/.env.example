# Which city this process serves. No default — an unset value is a
# deployment error (ARCHITECTURE.md §3.5).
SITE_SLUG=bali

# Repo root, used to locate <slug>/site/site.config.json. Defaults to
# ../../.. from engine/apps/web, which is correct for local dev.
# NOW_REPO_ROOT=/srv/now

# --- The domain-event bus, for `npm run dev` --------------------------------
# THIS FILE, not the repo-root .env. Next loads `.env*` from this directory;
# the root one is compose's and never reaches a dev server. Copy this to
# `.env.local` and fill it in.
#
# Without it `publishDomainEvent` logs, returns false, and every publish,
# unpublish and classification decision goes nowhere — silently, because it
# never throws, so a Redis outage cannot block an editor's save. That silence
# is why a publish hook announcing a false `article.unpublished` on every
# autosave could only be caught in production.
#
# ⚠️ THE PORT MUST MATCH `REDIS_PORT` IN THE ROOT `.env`, and this project
# deliberately remaps it. The root `.env.example` ships 6379 for portability,
# but the compose here is commonly run on 16379 to avoid colliding with other
# stacks on a shared machine — on the development box today, `localhost:6379`
# is a DIFFERENT project's Redis, currently running.
#
# Getting this wrong does not fail. It publishes NOW!'s domain events into
# somebody else's Redis, and nothing anywhere says so. Check what you are
# actually talking to before trusting it:
#
#   docker ps --format '{{.Names}}	{{.Ports}}' | grep 6379
#   scripts/tail-domain-events.sh          # should show YOUR events appearing
#
REDIS_URL=redis://:<REDIS_PASSWORD from the root .env>@localhost:16379/0

# Where reader emails (verify, reset password) link to: the origin this server
# is reached on. Required outside production -- without it, dev refuses to
# guess rather than linking to the city's live public domain.
SITE_BASE_URL=http://localhost:3100

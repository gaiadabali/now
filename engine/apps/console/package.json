{
  "name": "@now-engine/console",
  "version": "0.1.0",
  "private": true,
  "description": "Schema owner for `now_platform.public` — the staff identity store. NOT an app: its pages became /team-editor/commerce and its admin is retired. It exists so `public.users` has a migration home.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "generate:types": "payload generate:types"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "drizzle-orm": "0.45.2",
    "next": "15.4.11",
    "payload": "3.88.0",
    "pg": "8.13.1",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "server-only": "0.0.1",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.1",
    "cross-env": "7.0.3",
    "typescript": "5.7.2"
  },
  "overrides": {
    "drizzle-orm": "0.45.2"
  }
}

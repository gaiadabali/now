{
  "openapi": "3.1.0",
  "info": {
    "title": "NOW! Engine API",
    "description": "Multi-tenant read/write API for the NOW! Engine \u2014 one deployment, many cities.",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Healthz",
        "description": "Unauthenticated liveness probe for the load balancer.\n\nDeliberately does not touch any database -- a city or platform outage\nmust not make the load balancer think engine-api itself is down.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthzResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/{site}/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "City Health",
        "operationId": "city_health_v1__site__health_get",
        "parameters": [
          {
            "name": "site",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "City site slug, resolved against the `sites` registry.",
              "title": "Site"
            },
            "description": "City site slug, resolved against the `sites` registry."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CityHealthResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/{site}/events": {
      "options": {
        "tags": [
          "events"
        ],
        "summary": "Preflight Events",
        "description": "CORS preflight for the `fetch(..., {keepalive})` fallback transport.\n\nThe beacon's primary transport, `navigator.sendBeacon`, is always sent\nin `no-cors` mode by the browser and never triggers a preflight -- this\nhandler only matters for the fetch fallback (used when `sendBeacon` is\nunavailable) and for manual/XHR testing. No DB touched and no rate\nlimiting here: a preflight carries no body and no event data, so there\nis nothing to write and nothing to key a rate limit on.",
        "operationId": "preflight_events_v1__site__events_options",
        "parameters": [
          {
            "name": "site",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Site"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "events"
        ],
        "summary": "Post Events",
        "description": "Accepts one beacon batch and writes it into this city's tables.\n\nOrder of checks is deliberate:\n\n1. `Depends(get_city_db)` -- unknown/inactive site -> 404, registry or\n   city DB unreachable -> 503. Runs before the handler body at all\n   (FastAPI dependency resolution), so a bad site never even reaches\n   body parsing.\n2. Body-size ceiling, then JSON parse, then schema validation\n   (`EventsBatchIn`, which itself caps array length at\n   `MAX_EVENTS_PER_ARRAY`) -- malformed or oversized -> 4xx.\n3. CORS origin allowlist (decision C2) -- a disallowed browser\n   `Origin` -> 403.\n4. Rate limit keyed by the batch's `anon_id` -> 429.\n5. Write. A `ts` outside the currently provisioned partition window is\n   a client-data problem, translated to 400 rather than left to\n   surface as a raw database error.\n\nEvery one of the above is a controlled `HTTPException`; nothing here\nlets an unexpected exception escape as a bare 500 for these known\nfailure classes.",
        "operationId": "post_events_v1__site__events_post",
        "parameters": [
          {
            "name": "site",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "City site slug, resolved against the `sites` registry.",
              "title": "Site"
            },
            "description": "City site slug, resolved against the `sites` registry."
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CityHealthResponse": {
        "properties": {
          "site": {
            "type": "string",
            "title": "Site"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "database": {
            "type": "string",
            "title": "Database"
          },
          "latency_ms": {
            "type": "number",
            "title": "Latency Ms"
          }
        },
        "type": "object",
        "required": [
          "site",
          "status",
          "database",
          "latency_ms"
        ],
        "title": "CityHealthResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthzResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthzResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
# cms — one Payload config, one process per city. Every difference between
# deployments is an env var. Copy to `.env` and fill in for local dev; a real
# deployment sets these in the orchestrator (docker-compose / compose profile
# `apps`), never by editing this package's code.

# ---------------------------------------------------------------------------
# REQUIRED — the only variable that makes cms-<city-a> differ from
# cms-<city-b> (ARCHITECTURE.md §3.5). Payload binds exactly one database per
# instance. Point this at a city database, never at now_platform.
# ---------------------------------------------------------------------------
DATABASE_URI=postgresql://now:${POSTGRES_PASSWORD}@localhost:15432/now_jakarta

# Cosmetic only — used for admin-panel labelling and log lines, never for
# branching logic. Read from env at runtime; not a literal in source.
SITE_SLUG=

# Payload's field-encryption / session-signing secret. One value shared
# across every city deployment is fine (Payload does not use it to derive
# per-tenant anything); generate with `openssl rand -hex 32`.
PAYLOAD_SECRET=changeme-generate-with-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# Facet vocabulary source (ARCHITECTURE.md §4 / §5) — read-only. Payload
# binds only the city DB, so seeded terms/facets (type, subtype, location,
# format, cuisine, vibe, occasion, audience, amenities, price_band, topic)
# live in now_platform.engine and are fetched over a *separate*,
# *read-only* connection at CMS boot. See src/lib/vocabulary.ts and
# README.md "Facet vocabulary across two databases" for why.
# ---------------------------------------------------------------------------
PLATFORM_DATABASE_URI=postgresql://now:${POSTGRES_PASSWORD}@localhost:15432/now_platform

# ---------------------------------------------------------------------------
# Redis — publish hook target (ARCHITECTURE.md, "Publish hook"). Payload only
# announces `article.published`; it computes nothing itself.
# ---------------------------------------------------------------------------
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:16379/0

# ---------------------------------------------------------------------------
# Media storage (Garage, S3-compatible — ARCHITECTURE.md §14). Optional: if
# unset, Payload falls back to local disk storage under ./media, useful for
# boot-testing without a Garage bucket provisioned.
# ---------------------------------------------------------------------------
GARAGE_S3_ENDPOINT=http://localhost:3900
GARAGE_S3_REGION=garage
GARAGE_ACCESS_KEY_ID=
GARAGE_SECRET_ACCESS_KEY=
GARAGE_MEDIA_BUCKET=now-media

NODE_ENV=development
